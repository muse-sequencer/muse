      <Program id="98" name="User Kit 48"/>
      <Program id="99" name="User Kit 49"/>
    </Bank>
  </Group>

  <!-- Standard Drum Map Zuweisung für die 12 Hardware Pads -->
  <DrumMap name="SR-16 Standard Pads">
    <Key id="36" name="Pad 1: Kick"/>
    <Key id="38" name="Pad 2: Snare"/>
    <Key id="42" name="Pad 3: Closed Hat"/>
    <Key id="46" name="Pad 4: Open Hat"/>
    <Key id="48" name="Pad 5: High Tom"/>
    <Key id="45" name="Pad 6: Mid Tom"/>
    <Key id="41" name="Pad 7: Low Tom"/>
    <Key id="51" name="Pad 8: Ride Cymbal"/>
    <Key id="49" name="Pad 9: Crash Cymbal"/>
    <Key id="54" name="Pad 10: Percussion 1"/>
    <Key id="56" name="Pad 11: Percussion 2"/>
    <Key id="39" name="Pad 12: Handclap"/>
  </DrumMap>
</InstrumentDefinition>

<?xml version="1.0"?>
<muse version="1.0">
  <MidiInstrument name="Alesis SR-16">
    <!--
      Alesis SR-16 MusE instrument definition.

      Program Change mapping from the official SR-16 Reference Manual:
        PC 00-49  -> User Drum Sets 00-49
        PC 50-99  -> Preset Drum Sets 00-49
        PC 100-127 -> User Drum Sets 00-27 (aliases, intentionally omitted)

      On the SR-16 set MIDI SETUP / PRG CHNG = ON.

      This first version deliberately does NOT include a fixed drum map:
      in NORMAL mode the SR-16 note assignments are stored per Drum Set and
      can be changed by the user. A fixed map would therefore risk displaying
      incorrect drum names. It can be added once the desired SR-16 note map
      (or a factory/default mapping table) is confirmed.
    -->

    <PatchGroup name="User Drum Sets">
      <Patch name="User Drum Set 00" drum="1" prog="0"/>
      <Patch name="User Drum Set 01" drum="1" prog="1"/>
      <Patch name="User Drum Set 02" drum="1" prog="2"/>
      <Patch name="User Drum Set 03" drum="1" prog="3"/>
      <Patch name="User Drum Set 04" drum="1" prog="4"/>
      <Patch name="User Drum Set 05" drum="1" prog="5"/>
