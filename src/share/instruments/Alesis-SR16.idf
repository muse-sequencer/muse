      <Program id="33" name="33: Country 3"/>
      <Program id="34" name="34: Country Rock"/>
      <Program id="35" name="35: Rockabilly"/>
      <Program id="36" name="36: Jazz 1"/>
      <Program id="37" name="37: Jazz 2"/>
      <Program id="38" name="38: Dixie"/>
      <Program id="39" name="39: Waltz"/>
      <Program id="40" name="40: Shuffle"/>
      <Program id="41" name="41: Latin 1"/>
      <Program id="42" name="42: Latin 2"/>
