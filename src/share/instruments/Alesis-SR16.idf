<?xml version="1.0" encoding="UTF-8"?>
<InstrumentDefinition name="Alesis SR-16">
  <!-- Bank-Definitionen (Presets und User-Kits) -->
  <Group name="Drumkits">
    <Bank name="Preset Kits">
      <Program id="0" name="00: Rock 1"/>
      <Program id="1" name="01: Rock 2"/>
      <Program id="2" name="02: Rock 3"/>
      <Program id="3" name="03: Rock 4"/>
      <Program id="4" name="04: Rock 5"/>
      <Program id="5" name="05: Rock 6"/>
      <Program id="6" name="06: Rock 7"/>
      <Program id="7" name="07: Hard Rock 1"/>
