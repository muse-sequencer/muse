      <Program id="11" name="11: R&amp;B 2"/>
      <Program id="12" name="12: Funk 1"/>
      <Program id="13" name="13: Funk 2"/>
      <Program id="14" name="14: Blues 1"/>
      <Program id="15" name="15: Blues 2"/>
      <Program id="16" name="16: Rap 1"/>
      <Program id="17" name="17: Rap 2"/>
      <Program id="18" name="18: Techno 1"/>
      <Program id="19" name="19: Techno 2"/>
      <Program id="20" name="20: Reggae 2"/>
      <Program id="21" name="21: Ballad 2"/>
      <Program id="22" name="22: Ballad 4"/>
      <Program id="23" name="23: Big Band 2"/>
      <Program id="24" name="24: Brush 2"/>
      <Program id="25" name="25: Jazz Rock 1"/>
