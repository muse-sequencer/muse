      <Program id="47" name="47: Big Band 1"/>
      <Program id="48" name="48: Brush 1"/>
      <Program id="49" name="49: Studio Kit"/>
    </Bank>
    
    <Bank name="User Kits">
      <!-- Program-IDs 50-99 triggern die User-Kits 00-49 auf der Hardware -->
      <Program id="50" name="User Kit 00"/>
      <Program id="51" name="User Kit 01"/>
      <Program id="52" name="User Kit 02"/>
      <Program id="53" name="User Kit 03"/>
      <Program id="54" name="User Kit 04"/>
      <Program id="55" name="User Kit 05"/>
      <Program id="56" name="User Kit 06"/>
      <Program id="57" name="User Kit 07"/>
      <Program id="58" name="User Kit 08"/>
      <Program id="59" name="User Kit 09"/>
      <Program id="60" name="User Kit 10"/>
      <Program id="61" name="User Kit 11"/>
      <Program id="62" name="User Kit 12"/>
      <Program id="63" name="User Kit 13"/>
